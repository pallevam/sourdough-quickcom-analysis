# Copy to .streamlit/secrets.toml for local use (git-ignored), or paste into
# Streamlit Community Cloud: your app -> Settings -> Secrets.

# Required for the "Ask" chat tab. Create one at https://console.anthropic.com -> API keys.
ANTHROPIC_API_KEY = "sk-ant-..."

# Optional: a shared password everyone types once per browser session. Leave out to disable.
APP_PASSWORD = "choose-something"

# Optional spend controls for the chat tab.
CHAT_MAX_QUESTIONS = "25"          # per browser session
CHAT_MODEL = "claude-haiku-5-5"    # default; claude-sonnet-5-5 / claude-opus-5-5 cost more
CHAT_EFFORT = "medium"             # low | medium | high
